generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
}

enum CarStatus {
  AVAILABLE
  RESERVED
  SOLD
  INACTIVE
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
  LPG
}

enum Transmission {
  MANUAL
  AUTOMATIC
  AMT
  CVT
  DCT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

model Car {
  id                 String       @id @default(cuid())

  brand              String
  model              String
  variant            String?
  year               Int
  price              Decimal      @db.Decimal(12, 2)
  kmDriven           Int
  fuelType           FuelType
  transmission       Transmission
  ownerCount         Int          @default(1)
  location           String
  description        String?

  registrationNumber String?

  registrationState  String?
  color              String?
  ownerType          String?

  // RC
  rcAvailable        Boolean      @default(false)
  rcTransferAvailable Boolean     @default(false)
  originalRcAvailable Boolean     @default(false)
  rcNotes            String?

  // Insurance
  insuranceAvailable Boolean       @default(false)
  insuranceType      String?
  insuranceValidUntil DateTime?
  insuranceCompany   String?
  insurancePolicyNumber String?

  // PUC
  pucAvailable       Boolean      @default(false)
  pucValidUntil      DateTime?

  // Finance
  buyerFinanceAvailable Boolean   @default(false)
  existingFinance    Boolean      @default(false)
  financeCompany     String?
  financeOutstanding Decimal?      @db.Decimal(12, 2)
  financeClosed      Boolean      @default(false)

  // Service history
  serviceHistoryAvailable Boolean  @default(false)
  serviceHistoryNotes      String?
  lastServiceDate          DateTime?
  lastServiceKm            Int?

  // Condition
  accidentHistory      Boolean     @default(false)
  accidentHistoryNotes String?
  conditionNotes       String?

  // Warranty
  warrantyAvailable   Boolean      @default(false)
  warrantyValidUntil  DateTime?
  warrantyNotes       String?

  status              CarStatus    @default(AVAILABLE)
  featured            Boolean      @default(false)

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  images              CarImage[]
  enquiries           Enquiry[]

  @@index([status, createdAt])
  @@index([brand, model])
  @@index([price])
  @@index([year])
  @@index([fuelType, transmission])
  @@index([location])
}

model VehicleBrand {
  id        String         @id @default(cuid())
  name      String         @unique
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  models    VehicleModel[]

  @@index([isActive])
}

model VehicleModel {
  id        String          @id @default(cuid())
  brandId   String
  name      String
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  brand     VehicleBrand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  variants  VehicleVariant[]

  @@unique([brandId, name])
  @@index([brandId, isActive])
}

model VehicleVariant {
  id        String        @id @default(cuid())
  modelId   String
  name      String
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  model     VehicleModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, name])
  @@index([modelId, isActive])
}

model CarImage {
  id           String   @id @default(cuid())
  carId        String
  storagePath  String   @unique
  publicUrl    String
  originalName String?
  mimeType     String   @default("image/webp")
  sizeBytes    Int
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId, displayOrder])
}

model Enquiry {
  id           String   @id @default(cuid())
  carId        String?
  customerName String
  phone        String
  message      String?
  createdAt    DateTime @default(now())

  car Car? @relation(fields: [carId], references: [id], onDelete: SetNull)

  @@index([carId, createdAt])
  @@index([createdAt])
}
